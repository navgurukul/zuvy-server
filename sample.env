#Meraki Dashboard API

# strapi POST API URL
ZUVY_CONTENT_URL = ""
ZUVY_CONTENTS_API_URL = ""

# google client zuvy
GOOGLE_CLIENT_ID = ""
GOOGLE_SECRET = ""

GOOGLE_REDIRECT_URI = "http://localhost:5000/classes/redirect/"
ZUVY_REDIRECT_URL = "https://dev.app.zuvy.org/admin/courses"

#Drive credentials
DRIVE_FOLDER_ID = ""
DRIVE_API_KEY = ""

#S3 bucket credentials
S3_ACCESS_KEY_ID = ""
S3_SECRET_KEY_ACCESS = ""
S3_BUCKET_NAME = ""
S3_REGION = "ap-south-1"

# Session recording pipeline (Zoom -> S3 -> YouTube)
RECORDING_WORKER_ENABLED = "false"
YOUTUBE_UPLOAD_ENABLED = "false"
# Durable S3 copy, written and checksum-verified before the YouTube upload.
# Off by default; falls back to S3_BUCKET_NAME if unset.
S3_DUAL_UPLOAD_ENABLED = "false"
S3_RECORDINGS_BUCKET_NAME = ""
# Deletes Zoom's cloud copy (to Zoom's trash) once the S3 copy is verified.
# Off by default — a destructive call against an external system.
ZOOM_DELETE_AFTER_S3_ENABLED = "false"
# Nightly job (2 AM IST) that detects a YouTube video that died after a
# successful upload (takedown, strike, channel issue) and restores/re-uploads
# it from the Glacier S3 copy. Off by default. Never affects new uploads.
RECORDING_HEALTH_CHECK_ENABLED = "false"
GLACIER_RESTORE_DAYS = "7"
ZOOM_CLIENT_ID = ""
ZOOM_CLIENT_SECRET = ""
ZOOM_ACCOUNT_ID = ""
GOOGLE_CLIENT_SECRET = ""
GOOGLE_YT_REFRESH_TOKEN = ""

