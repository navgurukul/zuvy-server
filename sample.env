# Local DB Connection
DB_NAME = ""
DB_HOST = ""
DB_USER = ""
DB_PASS = ""
# Optional connection pool settings (defaults shown).
# Most connections per app process. Keep (processes x this) well under
# Postgres max_connections.
DB_POOL_MAX=10
# A query waiting longer than this for a lock fails instead of hanging.
DB_LOCK_TIMEOUT_MS=30000
# A transaction left idle longer than this (e.g. its connection was cut) is
# ended by the server, releasing its locks.
DB_IDLE_IN_TX_TIMEOUT_MS=120000

# port 
PORT = 5000

# base_url for zuvy api's
BASE_URL = "http://localhost:5000"

# C4CA Bucket Credentials
C4CA_BUCKET = ""
C4CA_ACCESS_KEY_ID = ""
C4CA_SECRET_ACCESS_KEY = ""

#Meraki client credentials
MERAKI_AUTH_CLIENT_ID = ""
MERAKI_AUTH_CLIENT_SECRET = ""
MERAKI_AUTH_REFRESH_TOKEN = ""
MERAKI_JWT_SECRET_KEY = ""

# JWT Secret Key for authentication
JWT_SECRET_KEY = "your-secret-key-here"

#Meraki Dashboard API

# strapi POST API URL
ZUVY_CONTENT_URL = ""
ZUVY_CONTENTS_API_URL = ""

# google client zuvy
GOOGLE_CLIENT_ID = ""
GOOGLE_SECRET = ""

GOOGLE_REDIRECT_URI = "http://localhost:5000/classes/redirect/"
ZUVY_REDIRECT_URL = "https://dev.app.zuvy.org/admin/courses"

#Drive credentials
DRIVE_FOLDER_ID = ""
DRIVE_API_KEY = ""

#S3 bucket credentials
S3_ACCESS_KEY_ID = ""
S3_SECRET_KEY_ACCESS = ""
S3_BUCKET_NAME = ""

# coding platform API keys
RAPID_API_KEY = ""
RAPID_HOST = "judge0-ce.p.rapidapi.com"
RAPID_BASE_URL = "https://judge0-ce.p.rapidapi.com"

# Zoom: comma-separated host emails exempted from the default annotation=off policy
ZOOM_ANNOTATION_ENABLED_HOSTS = ""
# Zoom licence pool: total Zoom licences in the account, protected ones
# included. Set it to the real number; if unset, 12 is assumed (and logged).
# Classes and mentor sessions share this minus the protected licences
# (the licence rows marked protected; 5 today, so 7 shared).
ZOOM_TOTAL_LICENSES=12
# Minutes a licence stays with its host after a session ends, so Zoom can
# process and upload the recording. At least 60 (lower values are raised).
ZOOM_LICENSE_COOLDOWN_MINUTES=60
# Detailed licence-pool logs on every allocation (extra queries while the
# pool lock is held). Off unless "true"; for debugging only.
ZOOM_LICENSE_VERBOSE_LOGS=false

# Student ID login (students without email)
# Cloudflare Turnstile secret key; the frontend uses the matching site key.
# Cloudflare test secret that accepts any token: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Optional: comma-separated hostnames the captcha must be solved on
TURNSTILE_ALLOWED_HOSTNAMES=
# Dev/testing only: skip the captcha check (ignored on production)
CAPTCHA_DISABLED=
# Optional per-IP ceilings (defaults: 60, 300, 600)
SIGNUP_LIMIT_PER_MINUTE=
SIGNUP_LIMIT_PER_HOUR=
LOGIN_LIMIT_PER_15_MINUTES=
# Optional: proxies trusted for the client IP (default: loopback,uniquelocal)
TRUST_PROXY=
# Mentor session attendance from Zoom (MentorAttendanceJob, every 10 min).
# Off unless "true". Needs migration 0047. Turn on for one server only.
MENTOR_ATTENDANCE_JOB_ENABLED=false
# Gives back the seat, licence and credit of a mentor booking whose Zoom
# meeting was never set up (MentorSlotJob, every 5 min). On unless "false".
MENTOR_ABANDONED_BOOKING_JOB_ENABLED=true
